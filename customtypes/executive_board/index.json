{
  "format": "custom",
  "id": "executive_board",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "allowTargetBlank": true,
          "label": "Title",
          "placeholder": "",
          "single": "heading2,heading3,heading4"
        },
        "type": "StructuredText"
      },
      "start": {
        "config": {
          "label": "Start",
          "placeholder": "Date the exec board starts"
        },
        "type": "Date"
      },
      "end": {
        "config": {
          "label": "End",
          "placeholder": "Date the exec board ends"
        },
        "type": "Date"
      },
      "members": {
        "config": {
          "fields": {
            "member": {
              "config": {
                "customtypes": [
                  {
                    "fields": [
                      "name",
                      {
                        "customtypes": [
                          {
                            "fields": [
                              "title"
                            ],
                            "id": "board_position"
                          }
                        ],
                        "id": "position"
                      },
                      "portrait",
                      "link"
                    ],
                    "id": "board_member"
                  }
                ],
                "label": "Member",
                "repeat": false,
                "select": "document"
              },
              "type": "Link"
            },
            "position": {
              "config": {
                "customtypes": [
                  {
                    "fields": [
                      "title"
                    ],
                    "id": "board_position"
                  }
                ],
                "label": "Position",
                "repeat": false,
                "select": "document"
              },
              "type": "Link"
            }
          },
          "label": "Members",
          "repeat": true
        },
        "type": "Group"
      }
    }
  },
  "label": "Executive Board",
  "repeatable": true,
  "status": true
}