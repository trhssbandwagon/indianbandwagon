{
  "id": "page",
  "label": "Page",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "TItle",
          "placeholder": "",
          "single": "heading1",
          "allowTargetBlank": true
        }
      },
      "parent": {
        "type": "Link",
        "config": {
          "label": "Parent",
          "select": "document",
          "customtypes": [
            {
              "id": "page",
              "fields": [
                "title",
                {
                  "id": "parent",
                  "customtypes": [
                    {
                      "id": "page",
                      "fields": [
                        "title",
                        "parent"
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "repeat": false
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "events": {
              "type": "SharedSlice"
            },
            "form": {
              "type": "SharedSlice"
            },
            "content_index": {
              "type": "SharedSlice"
            },
            "features": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "carousel": {
              "type": "SharedSlice"
            },
            "testimonial": {
              "type": "SharedSlice"
            },
            "process": {
              "type": "SharedSlice"
            },
            "image_with_text": {
              "type": "SharedSlice"
            },
            "rich_text": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "opt_out": {
              "type": "SharedSlice"
            },
            "dontation": {
              "type": "SharedSlice"
            },
            "board_index": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      },
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      }
    }
  },
  "status": true,
  "format": "page"
}