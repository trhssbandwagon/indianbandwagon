{
  "repositoryName": "indianbandwagon",
  "libraries": ["./src/slices"],
  "routes": [
    {
      "type": "homepage",
      "path": "/"
    },
    {
      "type": "page",
      "path": "/:parent?/:uid",
      "resolvers": {
        "parent": "parent"
      }
    },
    {
      "type": "post",
      "path": "/post/:uid"
    }
  ]
}
