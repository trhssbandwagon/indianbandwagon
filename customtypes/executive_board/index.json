          "label": "Members",
          "repeat": true,
          "fields": {
            "member": {
              "type": "Link",
              "config": {
                "label": "Member",
                "select": "document",
                "customtypes": [
                  {
                    "id": "board_member",
                    "fields": [
                      "name",
                      {
                        "id": "position",
                        "customtypes": [
                          {
