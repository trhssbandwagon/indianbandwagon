                      },
                      "portrait",
                      "link"
                    ]
                  }
                ],
                "repeat": false
              }
            },
            "position": {
              "type": "Link",
              "config": {
                "label": "Position",
                "select": "document",
                "customtypes": [
                  {
                    "id": "board_position",
                    "fields": [
                      "title"
                    ]
                  }
                ],
                "repeat": false
              }
            }
          }
