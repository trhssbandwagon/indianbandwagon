        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "",
          "single": "heading2,heading3,heading4",
          "allowTargetBlank": true
        }
      },
      "start": {
        "type": "Date",
        "config": {
          "label": "Start",
          "placeholder": "Date the exec board starts"
        }
      },
      "end": {
        "type": "Date",
        "config": {
          "label": "End",
          "placeholder": "Date the exec board ends"
        }
      },
      "members": {
        "type": "Group",
