            },
            "content_index": {
              "type": "SharedSlice"
            },
            "features": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "carousel": {
              "type": "SharedSlice"
            },
            "testimonial": {
              "type": "SharedSlice"
            },
            "process": {
              "type": "SharedSlice"
            },
            "image_with_text": {
              "type": "SharedSlice"
            },
            "rich_text": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "opt_out": {
              "type": "SharedSlice"
            },
            "dontation": {
              "type": "SharedSlice"
            },
            "board_index": {
              "type": "SharedSlice"
            }
