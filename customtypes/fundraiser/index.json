{
  "format": "page",
  "id": "fundraiser",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "allowTargetBlank": true,
          "label": "Title",
          "single": "heading1"
        },
        "type": "StructuredText"
      },
      "excerpt": {
        "config": {
          "allowTargetBlank": true,
          "label": "Excerpt",
          "single": "paragraph,strong,em"
        },
        "type": "StructuredText"
      },
      "featured_image": {
        "config": {
          "label": "Featured Image"
        },
        "type": "Image"
      },
      "custom_theme": {
        "config": {
          "customtypes": [
            {
              "fields": [
                "name",
                "primary_color",
                "primary_foreground_color",
                "secondary_color",
                "secondary_foreground_color",
                "accent_color",
                "accent_foreground_color",
                "ring_color",
                "background_pattern",
                "primary_color_dark",
                "primary_foreground_color_dark",
                "secondary_color_dark",
                "secondary_foreground_color_dark",
                "accent_color_dark",
                "accent_foreground_color_dark",
                "flourish_font"
              ],
              "id": "theme"
            }
          ],
          "label": "Custom Theme",
          "repeat": false,
          "select": "document"
        },
        "type": "Link"
      },
      "event_format": {
        "config": {
          "default_value": "in_person",
          "label": "Event Format",
          "options": [
            "in_person",
            "virtual",
            "hybrid"
          ],
          "placeholder": ""
        },
        "type": "Select"
      },
      "start": {
        "config": {
          "label": "Start",
          "placeholder": ""
        },
        "type": "Timestamp"
      },
      "end": {
        "config": {
          "label": "End",
          "placeholder": ""
        },
        "type": "Timestamp"
      },
      "venue_name": {
        "config": {
          "label": "Venue Name",
          "placeholder": ""
        },
        "type": "Text"
      },
      "street_address": {
        "config": {
          "label": "Street Address",
          "placeholder": ""
        },
        "type": "Text"
      },
      "city": {
        "config": {
          "label": "City",
          "placeholder": ""
        },
        "type": "Text"
      },
      "state": {
        "config": {
          "label": "State",
          "placeholder": ""
        },
        "type": "Text"
      },
      "zip_code": {
        "config": {
          "label": "Zip Code",
          "placeholder": ""
        },
        "type": "Text"
      },
      "virtual_link": {
        "config": {
          "allowTargetBlank": true,
          "allowText": true,
          "label": "Virtual Link",
          "placeholder": "",
          "repeat": false,
          "select": null
        },
        "type": "Link"
      },
      "slices": {
        "config": {
          "choices": {
            "rich_text": {
              "type": "SharedSlice"
            },
            "image_with_text": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "process": {
              "type": "SharedSlice"
            },
            "category_list": {
              "type": "SharedSlice"
            },
            "pricing_tier": {
              "type": "SharedSlice"
            },
            "event_details": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "allow_indexing": {
        "config": {
          "default_value": false,
          "label": "Allow Search Indexing",
          "placeholder_false": "false",
          "placeholder_true": "true"
        },
        "type": "Boolean"
      }
    }
  },
  "label": "Fundraiser",
  "repeatable": true,
  "status": true
}